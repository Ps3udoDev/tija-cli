          "description": "claude, codex, gemini o none; none aplica solo las reglas deterministas; omitido usa el default del CLI.",
          "type": "string"
        },
        "all": {
          "description": "Limpia todos los archivos soportados del repositorio.",
          "type": "boolean"
        },
        "paths": {
          "description": "Rutas relativas a la raíz; omitido limpia los archivos del diff.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "unsafe": {
          "description": "Aplica también cambios inseguros (código comentado, reescrituras). Requiere write: true.",
          "type": "boolean"
        },
        "write": {
          "description": "Debe ser true para escribir; sin write devuelve el plan con su diff y no toca archivos.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
